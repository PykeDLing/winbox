<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WinBoxWindowsTfm)</TargetFramework>
    <!-- MXC ProcessContainer needs Windows 11 25H2 (26200.9278+); that is checked at runtime. -->
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!--
      WinBox must run without package identity: inside a package context Windows virtualizes the files
      WinBox hands to MXC, and the sandbox cannot be created from them (see AppPaths). The Windows App
      SDK runtime ships next to the exe, so nothing has to be installed first.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinBox.Core\WinBox.Core.csproj" />
    <ProjectReference Include="..\WinBox.Platform\WinBox.Platform.csproj" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.UI.Reactor" />
    <!-- The title bar and window look for Assets\AppIcon.ico next to the exe. -->
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Debug only: the Reactor devtools behind the "Devtools" profile in Properties/launchSettings.json.
    Release builds leave them out so the trim and AOT analyzers stay quiet.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.UI.Reactor.Devtools" />
    <RuntimeHostConfigurationOption Include="Reactor.DevtoolsSupport" Value="true" Trim="true" />
  </ItemGroup>

  <Import Project="..\..\build\BoxHostPayload.targets" />
</Project>
