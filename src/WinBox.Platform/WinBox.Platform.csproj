<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows implementations of Core abstractions: MXC sandbox, installer extraction, PE metadata. -->
  <PropertyGroup>
    <TargetFramework>$(WinBoxWindowsTfm)</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Source-generated COM and LibraryImport for package activation. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinBox.Core\WinBox.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Mxc.Sdk" />
  </ItemGroup>

</Project>
