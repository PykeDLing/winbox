<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Windows-only projects share one TFM so the App, CLI and Platform layer stay in lockstep. -->
    <WinBoxWindowsTfm>net10.0-windows10.0.26100.0</WinBoxWindowsTfm>
    <!-- The release version, in every exe's file properties; GitHub releases are tagged v$(Version). -->
    <Version>0.2.0</Version>
  </PropertyGroup>

  <!--
    WinBox is compiled ahead of time (Native AOT). Native calls and COM go through source-generated
    marshalling only; with runtime marshalling disabled, anything that would need it fails to compile.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.DisableRuntimeMarshallingAttribute" />
  </ItemGroup>
</Project>
